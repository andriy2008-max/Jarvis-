<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Present only in debug. DUMP is system/shell permission, never third-party apps. -->
        <receiver
            android:name=".ScreenControlDebugReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.andriy.jarvis.preview.DEBUG_SCREEN_CONTROL"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
