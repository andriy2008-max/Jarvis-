<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Finance data must not leave the device as a plaintext Android Auto Backup. -->
    <exclude domain="database" path="jarvis-finance.db" />
        <exclude domain="database" path="jarvis-finance-secure.db" />
        <exclude domain="database" path="jarvis-finance-secure.db-wal" />
        <exclude domain="database" path="jarvis-finance-secure.db-shm" />
        <exclude domain="sharedpref" path="finance_secure_key.xml" />
        <exclude domain="sharedpref" path="finance_secure_migration.xml" />
    <exclude domain="database" path="jarvis-finance.db-wal" />
    <exclude domain="database" path="jarvis-finance.db-shm" />
    <exclude domain="sharedpref" path="finance_watch_queue.xml" />
        <exclude domain="sharedpref" path="finance_voice_clarifications.xml" />
        <exclude domain="sharedpref" path="finance_watch_followup.xml" />
    <exclude domain="file" path="finance-pre-restore.jfb" />
</full-backup-content>
