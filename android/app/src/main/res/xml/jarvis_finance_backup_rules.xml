<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Finance data must not leave the device as a plaintext Android Auto Backup. -->
    <exclude domain="database" path="jarvis-finance.db" />
    <exclude domain="database" path="jarvis-finance.db-wal" />
    <exclude domain="database" path="jarvis-finance.db-shm" />
    <exclude domain="sharedpref" path="finance_watch_queue.xml" />
    <exclude domain="file" path="finance-pre-restore.jfb" />
</full-backup-content>
