<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- User-requested wired/Bluetooth headset audio routing, released after speech. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Explicit one-time grant for the small round Jarvis orb. This is NOT Accessibility. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Only outgoing HTTPS to a user-configured AI proxy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Optional user-configured Wi-Fi and geofence conditions. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Explicit user approval through Android special-access settings required. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Flashlight optional: app also runs on tablets and Wear OS without a flash. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <!-- Delegates alarm/reminder requests to the installed system Clock app. -->
    <!-- Android AlarmClock.ACTION_SET_ALARM requires this exact platform permission. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <queries>
        <package android:name="com.shazam.android" />
        <package android:name="ee.mtakso.client" />
        <!-- Explicit local voice entry into Money Manager's UI only. -->
        <package android:name="com.freeman.moneymanager" />
        <!-- Personal Telegram MTProto client, only user-initiated. -->
        <package android:name="org.telegram.messenger" />
        <package android:name="com.arlosoft.macrodroid" />
        <!-- Spotify: user-requested app launch and verified accessibility controls. -->
        <package android:name="com.spotify.music" />
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- Query launcher-visible activities only, without QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.SET_TIMER" /></intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
    </queries>
    <application
        android:label="${appLabel}"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:supportsRtl="true">
        <service android:name=".JarvisPhoneCompanionService" android:exported="false"
            android:stopWithTask="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".JarvisPhoneCompanionRestoreReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Data Layer: same package and signing key on watch + phone required.
             Only the phone handles /request; the watch listens for /reply in foreground. -->
        <service
            android:name=".JarvisWearMessageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*"
                      android:path="/jarvis/phone-control/v1/request" />
            </intent-filter>
        </service>

        <!-- Android Quick Settings: pressing the tile opens only the circular overlay. -->
        <service
            android:name=".JarvisQuickTileService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="Джарвіс"
            android:icon="@drawable/ic_launcher">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE"
                       android:value="true" />
        </service>
        <!-- Android's default digital assistant / power-button ASSIST entry point.
             No hotword capture; the user must select Jarvis in system settings. -->
        <activity
            android:name=".JarvisAssistActivity"
            android:label="Джарвіс"
            android:icon="@drawable/ic_launcher"
            android:theme="@style/JarvisBubbleLaunchTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".JarvisBubbleLauncherActivity"
            android:theme="@style/JarvisBubbleLaunchTheme"
            android:excludeFromRecents="true"
            android:exported="false" />
        <!-- Telegram personal MTProto client. No notification-listener service. -->
        <activity android:name=".TelegramReplySettingsActivity"
            android:exported="false" android:screenOrientation="unspecified" />
        <service
            android:name=".FloatingJarvisService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <receiver android:name=".TimerFireReceiver" android:exported="false" />
        <receiver android:name=".JarvisMacroReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity android:name=".JarvisMacroActivity"
            android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".JarvisTaxiPlacesActivity"
            android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".SpotifyDirectSettingsActivity"
            android:exported="false" android:screenOrientation="unspecified" />
        <receiver android:name=".TimerRestoreReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Explicitly opt-in UI navigation, enabled only by the user in Android settings. -->
        <service
            android:name=".ScreenControlAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="Джарвіс — керування екраном">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/jarvis_screen_accessibility" />
        </service>
        <service
            android:name=".TimerAlertService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTop" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
